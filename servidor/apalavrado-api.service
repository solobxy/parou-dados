[Unit]
Description=apalavrado - API do mercado social (contas, anúncios, conversas, negócios protegidos)
After=network-online.target
Wants=network-online.target

[Service]
User=parou
Group=parou
StateDirectory=apalavrado-api
StateDirectoryMode=0700
EnvironmentFile=-/etc/apalavrado/api.env
Environment=TZ=Europe/Lisbon PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 /opt/apalavrado/api/api.py
Restart=always
RestartSec=3
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
LockPersonality=yes
MemoryMax=300M

[Install]
WantedBy=multi-user.target
