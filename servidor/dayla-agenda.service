[Unit]
Description=Dayla Araújo Body Piercing - pedidos de marcação e painel da Dayla
After=network-online.target
Wants=network-online.target

[Service]
User=parou
Group=parou
StateDirectory=dayla-agenda
StateDirectoryMode=0700
EnvironmentFile=-/etc/dayla-agenda/agenda.env
Environment=TZ=Europe/Lisbon
Environment=AG_PORTA=3180
Environment=AG_DB=/var/lib/dayla-agenda/agenda.db
ExecStart=/usr/bin/python3 /opt/parou/servidor/dayla/agenda.py
Restart=always
RestartSec=3
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
MemoryMax=200M

[Install]
WantedBy=multi-user.target
