[Unit]
Description=Kurogane - servidor de jogo online (PvP, quem dorme no mundo, mochilas e clãs)
After=network-online.target
Wants=network-online.target

[Service]
User=parou
Group=parou
StateDirectory=kurogane-srv
StateDirectoryMode=0700
Environment=TZ=Europe/Lisbon NODE_ENV=production PORT=3190 NODE_NO_WARNINGS=1
ExecStart=/usr/bin/node /opt/parou/servidor/kurogane/server.mjs
Restart=always
RestartSec=3
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
LockPersonality=yes
MemoryMax=300M

[Install]
WantedBy=multi-user.target
