# DUAS CHAVES - site de arrendamento (protótipo estático em /var/www/duaschaves, vindo de sites/duaschaves deste repositório)
# O endereço de testes (sslip.io) fica fora do Google; o domínio a sério (duplicasa.pt) é indexado.
(duaschaves) {
	import estatisticas
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "geolocation=(), camera=(), microphone=()"
		Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data: blob: https:; connect-src 'self'; form-action 'self'; frame-ancestors 'none'; base-uri 'none'"
		-Server
	}
	# API de contas e alertas (duaschaves-api.service, só em 127.0.0.1)
	handle /api/* {
		reverse_proxy 127.0.0.1:3110
	}
	# Os anúncios são recolhidos no próprio servidor (duaschaves-recolha.timer) e ficam fora da pasta do site
	# Páginas para o Google (geradas depois de cada recolha por duaschaves/paginas.py)
	handle /arrendar {
		redir * /arrendar/ 308
	}
	handle /arrendar/* {
		root * /var/lib/duaschaves-dados/seo
		file_server
	}
	# Versão longa do llms.txt, com os números de hoje (gerada com as páginas)
	handle /llms-full.txt {
		root * /var/lib/duaschaves-dados/seo
		header Cache-Control "public, max-age=1800"
		file_server
	}
	handle /sitemap.xml {
		root * /var/lib/duaschaves-dados/seo
		header Cache-Control "public, max-age=1800"
		file_server
	}
	# A lista completa (com os links dos anúncios originais) não é pública: o site usa lista.json, e os links
	# saem um a um pela API, só para quem tem o acesso
	handle /anuncios.json {
		respond 404
	}
	handle /links.json {
		respond 404
	}
	handle /estado-recolha.json {
		respond 404
	}
	# Lista leve para a pesquisa e detalhes por anúncio (escritos por recolher.py)
	handle /lista.json {
		root * /var/lib/duaschaves-dados
		header Cache-Control "no-cache"
		file_server
	}
	handle /det/* {
		root * /var/lib/duaschaves-dados
		header Cache-Control "public, max-age=300"
		file_server
	}
	# App instalável (PWA): o service worker nunca fica em cache no browser
	handle /sw.js {
		root * /var/www/duaschaves
		header Cache-Control "no-cache"
		file_server
	}
	handle /manifest.webmanifest {
		root * /var/www/duaschaves
		header Content-Type "application/manifest+json"
		header Cache-Control "public, max-age=3600"
		file_server
	}
	handle {
		root * /var/www/duaschaves
		file_server
	}
}

# Endereço de testes (funciona antes de o domínio apontar para aqui)
duaschaves.{HOST_TESTE} {
	header X-Robots-Tag "noindex, nofollow"
	handle /robots.txt {
		respond "User-agent: *
Disallow: /
" 200
	}
	import duaschaves
}

# O domínio ainda não está comprado: fica pronto para duplicasa.pt e chave.pt.
