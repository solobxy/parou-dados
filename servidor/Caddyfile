# PAROU.PT - Caddy (https automático com Let's Encrypt)
# {HOST_TESTE} é substituído pelo endereço <ip-com-tracos>.sslip.io do servidor (para testes).
# Os blocos do parou.pt só entram quando o domínio já aponta para este servidor (o
# atualizador confirma o DNS a cada 2 min): assim o certificado é pedido logo à primeira.

(app) {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "geolocation=(self), camera=(), microphone=()"
		-Server
	}
	reverse_proxy 127.0.0.1:3000
}

# Endereço de testes: tem também a página de estado do servidor (não aparece no parou.pt)
{HOST_TESTE} {
	handle /_estado-servidor {
		root * /var/lib/parou-estado
		rewrite * /estado.txt
		header Content-Type "text/plain; charset=utf-8"
		header Cache-Control "no-store"
		file_server
	}
	# Só totais do registo de segurança (sem IPs nem rotas): lido pela vigia automática do GitHub
	handle /_seguranca-servidor {
		root * /var/lib/parou-estado
		rewrite * /seguranca.json
		header Content-Type "application/json; charset=utf-8"
		header Cache-Control "no-store"
		file_server
	}
	import app
}

# INICIO parou.pt
parou.pt {
	import app
}
# FIM parou.pt

# INICIO www.parou.pt
www.parou.pt {
	redir https://parou.pt{uri} permanent
}
# FIM www.parou.pt

# ANJINHO.PT - lista de espera (site estático em /var/www/anjinho + /api/lista no 127.0.0.1:3100)
(anjinho) {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "geolocation=(), camera=(), microphone=()"
		Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; form-action 'self'; frame-ancestors 'none'; base-uri 'none'"
		-Server
	}
	handle /api/lista {
		request_body {
			max_size 4KB
		}
		reverse_proxy 127.0.0.1:3100
	}
	handle {
		root * /var/www/anjinho
		@fontes path /fontes/*
		header @fontes Cache-Control "public, max-age=31536000, immutable"
		try_files {path} {path}.html
		file_server
	}
}

# Endereço de testes da anjinho (funciona antes de o domínio apontar para aqui)
anjinho.{HOST_TESTE} {
	import anjinho
}

# INICIO anjinho.pt
anjinho.pt {
	import anjinho
}
# FIM anjinho.pt

# INICIO www.anjinho.pt
www.anjinho.pt {
	redir https://anjinho.pt{uri} permanent
}
# FIM www.anjinho.pt
