	redir https://caiu.pt{uri} permanent
}
# FIM www.caiu.pt

# GANHAS.PT - salários reais em Portugal (estático em /var/www/ganhas, gerado por ganhas/gerar.py para sites/ganhas).
# Partilhas anónimas pela API ganhas-api.service (127.0.0.1:3140). Páginas das empresas (só com 5 ou mais pessoas)
# geradas no servidor por ganhas/paginas_empresas.py para /var/lib/ganhas-paginas.
(ganhas) {
	import estatisticas
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "geolocation=(), camera=(), microphone=(), payment=(), usb=()"
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; worker-src 'self'; manifest-src 'self'; form-action 'self'; frame-ancestors 'none'; base-uri 'none'; object-src 'none'"
		Cross-Origin-Opener-Policy "same-origin"
		Cross-Origin-Resource-Policy "same-origin"
		-Server
	}
	@escondidos path_regexp /\.
	handle @escondidos {
		respond 404
	}
	handle /api/* {
		request_body {
			max_size 16KB
		}
		reverse_proxy 127.0.0.1:3140 {
			header_up X-Real-IP {remote_host}
			header_up -Cookie
		}
	}
	handle /empresa {
		redir * /empresa/ 308
	}
	handle /empresa/* {
		root * /var/lib/ganhas-paginas
		header Cache-Control "public, max-age=900"
		file_server
	}
	handle /sitemap-empresas.xml {
		root * /var/lib/ganhas-paginas
		header Cache-Control "public, max-age=3600"
		file_server
	}
	handle {
		root * /var/www/ganhas
		@fontes path /fontes/*
		header @fontes Cache-Control "public, max-age=31536000, immutable"
		@ativos path /estilo.css /app.js /prova.js /og/* /icone-*.png /favicon.svg /favicon.ico
		header @ativos Cache-Control "public, max-age=86400"
		@paginas not path /fontes/* /estilo.css /app.js /prova.js /og/* /icone-*.png /favicon.svg /favicon.ico
		header @paginas Cache-Control "no-cache"
		@manifesto path /manifest.webmanifest
		header @manifesto Content-Type "application/manifest+json"
		file_server
	}
	handle_errors {
		@nf expression {err.status_code} == 404
		handle @nf {
			root * /var/www/ganhas
			rewrite * /404.html
			file_server
		}
	}
}

# Endereço de testes (funciona antes de o domínio apontar para aqui; fica fora do Google)
ganhas.{HOST_TESTE} {
	header X-Robots-Tag "noindex, nofollow"
	handle /robots.txt {
		respond "User-agent: *
Disallow: /
" 200
	}
	import ganhas
}

# INICIO ganhas.pt
ganhas.pt {
	import ganhas
}
# FIM ganhas.pt

# INICIO www.ganhas.pt
www.ganhas.pt {
	redir https://ganhas.pt{uri} permanent
}
# FIM www.ganhas.pt
