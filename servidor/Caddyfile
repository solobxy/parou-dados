# CAIU.PT - comparador de preços dos supermercados (estático em /var/www/caiu, vindo de sites/caiu deste repositório).
# Os preços são recolhidos neste servidor (caiu-recolha.timer, caiu/recolher.py) para /var/lib/caiu-dados
# e servidos em /dados/. As fotos dos produtos vêm diretamente das lojas.
(caiu) {
	import estatisticas
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "geolocation=(), camera=(), microphone=(), payment=(), usb=(), interest-cohort=()"
		Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://www.continente.pt https://static.pingodoce.pt https://www.auchan.pt; font-src 'self'; connect-src 'self'; manifest-src 'self'; object-src 'none'; form-action 'self'; frame-ancestors 'none'; base-uri 'none'"
		Cross-Origin-Opener-Policy "same-origin"
		-Server
	}
	@escondidos path_regexp ^/\.
	handle @escondidos {
		respond 404
	}
	# Preços do dia (resumo.json, lista.json, h/<produto>.json, estado.json); a base de dados não sai daqui
	handle_path /dados/* {
		@privado path /historico.db* /*.tmp
		respond @privado 404
		root * /var/lib/caiu-dados
		header Cache-Control "public, max-age=600"
		file_server
	}
	handle {
		root * /var/www/caiu
		@fontes path /fontes/*
		header @fontes Cache-Control "public, max-age=31536000, immutable"
		@imagens path /*.png /favicon.svg
		header @imagens Cache-Control "public, max-age=604800"
		@revalidar path / /index.html /app.js /estilo.css /manifest.webmanifest
		header @revalidar Cache-Control "no-cache"
		@manifesto path /manifest.webmanifest
		header @manifesto Content-Type "application/manifest+json"
		file_server
	}
}

# Endereço de testes (funciona antes de o domínio apontar para aqui; fica fora do Google)
caiu.{HOST_TESTE} {
	header X-Robots-Tag "noindex, nofollow"
	handle /robots.txt {
		respond "User-agent: *
Disallow: /
" 200
	}
	import caiu
}

# INICIO caiu.pt
caiu.pt {
	import caiu
}
# FIM caiu.pt

# INICIO www.caiu.pt
