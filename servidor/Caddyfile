# PAROU.PT - Caddy (https automático com Let's Encrypt)
# {HOST_TESTE} é substituído pelo endereço <ip-com-tracos>.sslip.io do servidor (para testes).
# Os blocos do parou.pt só entram quando o domínio já aponta para este servidor (o
# atualizador confirma o DNS a cada 2 min): assim o certificado é pedido logo à primeira.

(app) {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "geolocation=(self), camera=(), microphone=()"
		-Server
	}
	reverse_proxy 127.0.0.1:3000
}

# Endereço de testes: tem também a página de estado do servidor (não aparece no parou.pt)
{HOST_TESTE} {
	handle /_estado-servidor {
		root * /var/lib/parou-estado
		rewrite * /estado.txt
		header Content-Type "text/plain; charset=utf-8"
		header Cache-Control "no-store"
		file_server
	}
	# Só totais do registo de segurança (sem IPs nem rotas): lido pela vigia automática do GitHub
	handle /_seguranca-servidor {
		root * /var/lib/parou-estado
		rewrite * /seguranca.json
		header Content-Type "application/json; charset=utf-8"
		header Cache-Control "no-store"
		file_server
	}
	import app
}

# INICIO parou.pt
parou.pt {
	import app
}
# FIM parou.pt

# INICIO www.parou.pt
www.parou.pt {
	redir https://parou.pt{uri} permanent
}
# FIM www.parou.pt

# ANJINHO.PT - lista de espera (site estático em /var/www/anjinho + /api/lista no 127.0.0.1:3100)
(anjinho) {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "geolocation=(), camera=(), microphone=()"
		Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; form-action 'self'; frame-ancestors 'none'; base-uri 'none'"
		-Server
	}
	handle /api/lista {
		request_body {
			max_size 4KB
		}
		reverse_proxy 127.0.0.1:3100
	}
	handle {
		root * /var/www/anjinho
		@fontes path /fontes/*
		header @fontes Cache-Control "public, max-age=31536000, immutable"
		try_files {path} {path}.html
		file_server
	}
}

# Endereço de testes da anjinho (funciona antes de o domínio apontar para aqui)
anjinho.{HOST_TESTE} {
	import anjinho
}

# INICIO anjinho.pt
anjinho.pt {
	import anjinho
}
# FIM anjinho.pt

# INICIO www.anjinho.pt
www.anjinho.pt {
	redir https://anjinho.pt{uri} permanent
}
# FIM www.anjinho.pt

# JINXED - site estático de demonstração em /var/www/jinxed (copiado à mão, fora do repositório)
(jinxed) {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "geolocation=(), camera=(), microphone=()"
		X-Robots-Tag "noindex, nofollow"
		-Server
	}
	root * /var/www/jinxed
	file_server
}

jinxed.{HOST_TESTE} {
	import jinxed
}

# INICIO jinxed.world
jinxed.world {
	import jinxed
}
# FIM jinxed.world

# INICIO www.jinxed.world
www.jinxed.world {
	redir https://jinxed.world{uri} permanent
}
# FIM www.jinxed.world

# DUAS CHAVES - site de arrendamento (protótipo estático em /var/www/duaschaves, vindo de sites/duaschaves deste repositório)
# O endereço de testes (sslip.io) fica fora do Google; o domínio a sério (duaschaves.pt) é indexado.
(duaschaves) {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "geolocation=(), camera=(), microphone=()"
		Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data: blob: https:; connect-src 'self'; form-action 'self'; frame-ancestors 'none'; base-uri 'none'"
		-Server
	}
	# API de contas e alertas (duaschaves-api.service, só em 127.0.0.1)
	handle /api/* {
		reverse_proxy 127.0.0.1:3110
	}
	# Os anúncios são recolhidos no próprio servidor (duaschaves-recolha.timer) e ficam fora da pasta do site
	# Páginas para o Google (geradas depois de cada recolha por duaschaves/paginas.py)
	handle /arrendar {
		redir * /arrendar/ 308
	}
	handle /arrendar/* {
		root * /var/lib/duaschaves-dados/seo
		file_server
	}
	handle /sitemap.xml {
		root * /var/lib/duaschaves-dados/seo
		header Cache-Control "public, max-age=1800"
		file_server
	}
	handle /anuncios.json {
		root * /var/lib/duaschaves-dados
		header Cache-Control "no-cache"
		file_server
	}
	# Lista leve para a pesquisa e detalhes por anúncio (escritos por recolher.py)
	handle /lista.json {
		root * /var/lib/duaschaves-dados
		header Cache-Control "no-cache"
		file_server
	}
	handle /det/* {
		root * /var/lib/duaschaves-dados
		header Cache-Control "public, max-age=300"
		file_server
	}
	handle {
		root * /var/www/duaschaves
		file_server
	}
}

# Endereço de testes (funciona antes de o domínio apontar para aqui)
duaschaves.{HOST_TESTE} {
	header X-Robots-Tag "noindex, nofollow"
	handle /robots.txt {
		respond "User-agent: *
Disallow: /
" 200
	}
	import duaschaves
}

# O domínio ainda não está comprado: fica pronto para duaschaves.pt e chave.pt.
# Cada bloco só entra quando o domínio já aponta para este servidor (ver atualizar.sh).
# INICIO duaschaves.pt
duaschaves.pt {
	import duaschaves
}
# FIM duaschaves.pt

# INICIO www.duaschaves.pt
www.duaschaves.pt {
	redir https://duaschaves.pt{uri} permanent
}
# FIM www.duaschaves.pt

# INICIO chave.pt
chave.pt {
	import duaschaves
}
# FIM chave.pt

# INICIO www.chave.pt
www.chave.pt {
	redir https://chave.pt{uri} permanent
}
# FIM www.chave.pt
