# TAPMOSS - jogo de fazer crescer musgo (estático em /var/www/tapmoss, vindo de sites/tapmoss deste repositório).
# Instalável (manifest + sw.js) e funciona sem rede; o tempo real vem do Open-Meteo; a localização só com autorização.
(tapmoss) {
	import estatisticas
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "geolocation=(self), camera=(), microphone=(), payment=(), usb=(), interest-cohort=()"
		# os anúncios da Google (AdSense e o aviso de consentimento) vêm de muitos endereços da Google: scripts, imagens, ligações e janelas por https
		Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https:; style-src 'self' 'unsafe-inline' https:; img-src 'self' data: https:; font-src 'self' data: https:; connect-src 'self' https:; frame-src https:; worker-src 'self'; manifest-src 'self'; object-src 'none'; form-action 'self'; frame-ancestors 'none'; base-uri 'none'"
		Cross-Origin-Opener-Policy "same-origin"
		-Server
	}
	# hidden files stay hidden, except the link between the Android app and the site (without it the app shows the address bar)
	@escondidos {
		path_regexp ^/\.
		not path /.well-known/assetlinks.json
	}
	handle @escondidos {
		respond 404
	}
	# the Android app to download: its own type, saved as a file, never kept by a cache
	@apk path /tapmoss.apk
	header @apk {
		Content-Type "application/vnd.android.package-archive"
		Content-Disposition "attachment; filename=\"tapmoss.apk\""
		Cache-Control "no-cache"
	}
	# Jogo online (contas, amigos, mapa): só as funções tm_* do Supabase, e só com a chave deste servidor
	handle_path /api/* {
		@rpc path_regexp ^/tm_[a-z_]{2,30}$
		handle @rpc {
			@outro not method POST
			respond @outro 405
			request_body {
				max_size 400KB
			}
			rewrite * /rest/v1/rpc{path}
			reverse_proxy https://hvvvswhwcpavucwrvlsf.supabase.co {
				header_up Host {upstream_hostport}
				header_up apikey sb_publishable_aGAxV-VSm1YIjgd-sXWDgQ_dJkhYFpa
				header_up Content-Type application/json
				header_up X-Estat-Ip {remote_host}
				header_up X-Estat-Chave {ESTAT_CHAVE}
				header_up -Cookie
				header_up -Authorization
				header_up -Origin
				header_up -Referer
				header_up -X-Forwarded-For
				header_down -Set-Cookie
				header_down Cache-Control "no-store"
			}
		}
		handle {
			respond 404
		}
	}
	# invite links (/a/CODE and /pt/a/CODE...): link previews get a picture of the player's own gardener (made by their game), people go on to the game
	@conviteImg path_regexp convI ^/(?:(pt|es|fr|de|ja|zh)/)?a/([A-Z0-9]{6})\.png$
	handle @conviteImg {
		rewrite * /functions/v1/tm-convite?c={re.convI.2}&l={re.convI.1}&png=1
		reverse_proxy https://hvvvswhwcpavucwrvlsf.supabase.co {
			header_up Host {upstream_hostport}
			header_up -Cookie
			header_down -Set-Cookie
		}
	}
	@convite path_regexp conv ^/(?:(pt|es|fr|de|ja|zh)/)?a/([A-Z0-9]{6})/?$
	handle @convite {
		header X-Robots-Tag "noindex"
		rewrite * /functions/v1/tm-convite?c={re.conv.2}&l={re.conv.1}
		reverse_proxy https://hvvvswhwcpavucwrvlsf.supabase.co {
			header_up Host {upstream_hostport}
			header_up -Cookie
			header_down -Set-Cookie
			header_down Content-Type "text/html; charset=utf-8"
		}
	}
	root * /var/www/tapmoss
	@icones path /*.png /fonts/* /img/*
	header @icones Cache-Control "public, max-age=604800"
	# pages (the game in each language, the guides) and the files crawlers read: always checked for a newer version
	@revalidar path / /index.html /sw.js /manifest.json */ *.html /sitemap.xml /robots.txt
	header @revalidar Cache-Control "no-cache"
	# /en/... is the same as the root: one address per page
	redir /en / permanent
	@en path_regexp en ^/en(/.*)$
	redir @en {re.en.1} permanent
	# shared garden links (/g/CODE, /pt/g/CODE...): the game page of that language opens the garden; never indexed
	@jardimL path_regexp jardimL ^/(pt|es|fr|de|ja|zh)/g/[A-Z2-9]{8}/?$
	@jardim path_regexp ^/g/[A-Z2-9]{8}/?$
	header @jardimL X-Robots-Tag "noindex"
	header @jardimL Cache-Control "no-cache"
	header @jardim X-Robots-Tag "noindex"
	header @jardim Cache-Control "no-cache"
	rewrite @jardimL /{re.jardimL.1}/index.html
	rewrite @jardim /index.html
	file_server
	handle_errors {
		@nf expression {err.status_code} == 404
		handle @nf {
			root * /var/www/tapmoss
			rewrite * /404.html
			file_server
		}
	}
}

# Endereço de testes (funciona antes de haver domínio; fica fora do Google)
tapmoss.{HOST_TESTE} {
	header X-Robots-Tag "noindex, nofollow"
	handle /robots.txt {
		respond "User-agent: *
Disallow: /
" 200
	}
	import tapmoss
}

