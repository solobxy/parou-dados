# PAROU.PT - Caddy (https automático com Let's Encrypt)
# {HOST_TESTE} é substituído pelo endereço <ip-com-tracos>.sslip.io do servidor (para testes).
# Os blocos do parou.pt só entram quando o domínio já aponta para este servidor (o
# atualizador confirma o DNS a cada 2 min): assim o certificado é pedido logo à primeira.

# ESTATÍSTICAS - recolha própria para todos os sites (sem cookies e sem guardar IPs).
# /_e.js é o script (servidor/estatisticas/e.js, copiado para /var/www/_estatisticas) e /_e recebe os dados,
# que seguem para o Supabase (projeto «estatisticas», função recolher). {ESTAT_CHAVE} é posto pelo atualizar.sh
# a partir de /etc/estatisticas.env, gerado no próprio servidor (o Supabase só guarda o hash dessa chave).
# Para um site novo: «import estatisticas» no bloco do site e <script defer src="/_e.js" data-site="ID"></script> no HTML.
(estatisticas) {
	handle /_e.js {
		root * /var/www/_estatisticas
		rewrite * /e.js
		header Cache-Control "public, max-age=3600"
		file_server
	}
	handle /_e {
		@outro not method POST
		respond @outro 405
		request_body {
			max_size 32KB
		}
		rewrite * /rest/v1/rpc/recolher
		reverse_proxy https://hvvvswhwcpavucwrvlsf.supabase.co {
			header_up Host {upstream_hostport}
			header_up apikey sb_publishable_aGAxV-VSm1YIjgd-sXWDgQ_dJkhYFpa
			header_up Content-Type application/json
			header_up X-Estat-Ip {remote_host}
			header_up X-Estat-Chave {ESTAT_CHAVE}
			header_up -Cookie
			header_up -Authorization
			header_up -Origin
			header_up -Referer
			header_up -X-Forwarded-For
			header_down -Set-Cookie
		}
	}
}

(app) {
	import estatisticas
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "geolocation=(self), camera=(), microphone=()"
		-Server
	}
	reverse_proxy 127.0.0.1:3000
}

# Endereço de testes: tem também a página de estado do servidor (não aparece no parou.pt)
{HOST_TESTE} {
	handle /_estado-servidor {
		root * /var/lib/parou-estado
		rewrite * /estado.txt
		header Content-Type "text/plain; charset=utf-8"
		header Cache-Control "no-store"
		file_server
	}
	# Só totais do registo de segurança (sem IPs nem rotas): lido pela vigia automática do GitHub
	handle /_seguranca-servidor {
		root * /var/lib/parou-estado
		rewrite * /seguranca.json
		header Content-Type "application/json; charset=utf-8"
		header Cache-Control "no-store"
		file_server
	}
	import app
}

# INICIO parou.pt
parou.pt {
	import app
}
# FIM parou.pt

# INICIO www.parou.pt
www.parou.pt {
	redir https://parou.pt{uri} permanent
}
# FIM www.parou.pt

# ANJINHO.PT - lista de espera (site estático em /var/www/anjinho + /api/lista no 127.0.0.1:3100)
(anjinho) {
	import estatisticas
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "geolocation=(), camera=(), microphone=()"
		Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; form-action 'self'; frame-ancestors 'none'; base-uri 'none'"
		-Server
	}
	handle /api/lista {
		request_body {
			max_size 4KB
		}
		reverse_proxy 127.0.0.1:3100
	}
	handle {
		root * /var/www/anjinho
		@fontes path /fontes/*
		header @fontes Cache-Control "public, max-age=31536000, immutable"
		try_files {path} {path}.html
		file_server
	}
}

