# JAESTA.PT - «já está», sites feitos antes de pedir (estático em /var/www/jaesta, vindo de sites/jaesta deste repositório)
(jaesta) {
	import estatisticas
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "geolocation=(), camera=(), microphone=()"
		Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; form-action 'self'; frame-ancestors 'none'; base-uri 'none'"
		-Server
	}
	root * /var/www/jaesta
	# Preenche {{.Host}} nas etiquetas de partilha (imagem do WhatsApp em qualquer endereço)
	templates {
		mime text/html
	}
	@estaticos path /fontes/* /img/* /m/fontes/* *.svg *.jpg *.png *.webp *.woff
	header @estaticos Cache-Control "public, max-age=2592000"
