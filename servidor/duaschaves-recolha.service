[Unit]
Description=Duas Chaves - recolha de anúncios públicos de arrendamento
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=parou
Group=parou
StateDirectory=duaschaves-dados
StateDirectoryMode=0755
UMask=0022
ExecStart=/usr/bin/python3 /opt/parou/servidor/duaschaves/recolher.py /var/lib/duaschaves-dados/anuncios.json
ExecStartPost=/usr/bin/python3 /opt/parou/servidor/duaschaves/paginas.py /var/lib/duaschaves-dados/anuncios.json /var/lib/duaschaves-dados/seo
TimeoutStartSec=40min
Nice=10
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
MemoryMax=400M
