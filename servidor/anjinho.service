[Unit]
Description=anjinho.pt - lista de espera
After=network.target

[Service]
ExecStart=/usr/bin/node /opt/anjinho/lista.mjs
Environment=NODE_ENV=production PORT=3100
DynamicUser=yes
StateDirectory=anjinho
StateDirectoryMode=0700
Restart=always
RestartSec=3
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
MemoryMax=200M

[Install]
WantedBy=multi-user.target
