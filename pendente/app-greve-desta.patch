 =?UTF-8?q?uinta-feira=C2=BB=20=C3=A9=20o=20pr=C3=B3prio=20dia=20(evita=20?=
 =?UTF-8?q?uma=20greve=20falsa=20da=20CP=20a=203/12)?=
